# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
# IMPORTANT: Redirect URI in Discord Developer Portal MUST be:
# {DASHBOARD_URL}/auth/callback
# Example: https://cursed-v2-production.up.railway.app/auth/callback
DISCORD_CLIENT_SECRET=your_client_secret_here

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cursed

# Dashboard
# IMPORTANT: Must be HTTPS in production, no trailing slash
# Example: https://cursed-v2-production.up.railway.app
DASHBOARD_URL=https://your-railway-url.railway.app
PORT=3000
SESSION_SECRET=your-session-secret-here

# AI Services
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Payment Services
KOFI_VERIFICATION_TOKEN=your_kofi_token_here
PATREON_WEBHOOK_SECRET=your_patreon_secret_here
BMC_WEBHOOK_SECRET=your_bmac_secret_here
STRIPE_SECRET_KEY=your_stripe_key_here

# Admin Discord IDs (comma-separated)
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# Optional
REDIS_URL=redis://localhost:6379
DEBUG=false
NODE_ENV=production
