<%- include('partials/header') %>

<main class="main-wrapper">
  <%- include('partials/sidebar') %>
  
  <section style="display: flex; flex-direction: column; gap: 24px;">
    <div>
      <h2 style="font-size: 28px; margin-bottom: 4px;">AI Model Configurations</h2>
      <p>Configure bot system personalities, response parameters, and active text channels.</p>
    </div>

    <!-- AI Settings Form -->
    <div class="glass-panel">
      <h3 style="font-size: 18px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
        <i class="bi bi-cpu-fill" style="color: var(--accent-glow);"></i> Server AI Personality
      </h3>

      <form action="/api/ai/<%= guild.guildId %>" method="POST">
        <div class="form-group">
          <label class="form-label">System Instruction Prompt (Server Persona)</label>
          <textarea name="personality" rows="5" class="form-textarea" required><%= guild.ai?.personality || 'You are a helpful Discord AI assistant.' %></textarea>
          <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-top: 4px;">This prompt instructs the bot on how to act, talk, and respond to chat messages in this server.</span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="form-group">
            <label class="form-label">AI Generation Mode</label>
            <select name="aimode" class="form-select">
              <option value="STANDARD" <%= guild.ai?.aimode === 'STANDARD' ? 'selected' : '' %>>STANDARD (Balanced)</option>
              <option value="CREATIVE" <%= guild.ai?.aimode === 'CREATIVE' ? 'selected' : '' %>>CREATIVE (High Randomness)</option>
              <option value="STRICT" <%= guild.ai?.aimode === 'STRICT' ? 'selected' : '' %>>STRICT (Factual/Deterministic)</option>
            </select>
            <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-top: 4px;">Adjusts temperature values of the LLM completions.</span>
          </div>

          <div class="form-group">
            <label class="form-label">Whitelisted AI Channels (Comma separated IDs)</label>
            <input type="text" name="activeChannels" value="<%= guild.ai?.activeChannels ? guild.ai.activeChannels.join(', ') : '' %>" placeholder="112233445566778899, 998877665544332211" class="form-input">
            <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-top: 4px;">Channels where the bot will automatically reply to every message without needing a mention.</span>
          </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill"></i> Save AI Settings</button>
      </form>
    </div>
  </section>
</main>

<script>
  document.getElementById('nav-ai').classList.add('active');
</script>

<%- include('partials/footer') %>
