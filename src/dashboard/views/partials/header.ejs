<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CURSED Bot Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
  <header>
    <div class="nav-container">
      <a href="/" class="logo-link">
        <i class="bi bi-skull-fill"></i>
        <span>CURSED</span>
      </a>
      <div class="user-profile-menu">
        <% if (user) { %>
          <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="user-avatar">
          <span style="font-weight: 500; font-size: 14px;"><%= user.username %></span>
          <a href="/auth/logout" class="btn btn-secondary" style="padding: 8px 16px; font-size: 13px;">Logout</a>
        <% } else { %>
          <a href="/auth" class="btn btn-primary" style="padding: 8px 16px; font-size: 13px;">Login with Discord</a>
        <% } %>
      </div>
    </div>
  </header>
