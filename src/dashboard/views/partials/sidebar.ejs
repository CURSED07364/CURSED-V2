<aside class="sidebar">
  <div style="margin-bottom: 24px;">
    <h3 style="font-size: 16px; color: var(--accent-glow); margin-bottom: 4px;"><%= guild.name %></h3>
    <span style="font-size: 12px; color: var(--text-secondary);">ID: <%= guild.guildId %></span>
  </div>
  
  <a href="/dashboard/<%= guild.guildId %>" class="sidebar-link" id="nav-overview">
    <i class="bi bi-speedometer2"></i> Overview
  </a>
  <a href="/dashboard/<%= guild.guildId %>/premium" class="sidebar-link" id="nav-premium">
    <i class="bi bi-shield-lock-fill"></i> Premium
  </a>
  <a href="/dashboard/<%= guild.guildId %>/moderation" class="sidebar-link" id="nav-moderation">
    <i class="bi bi-shield-slash-fill"></i> Moderation
  </a>
  <a href="/dashboard/<%= guild.guildId %>/economy" class="sidebar-link" id="nav-economy">
    <i class="bi bi-cash-coin"></i> Economy
  </a>
  <a href="/dashboard/<%= guild.guildId %>/ai" class="sidebar-link" id="nav-ai">
    <i class="bi bi-cpu-fill"></i> AI Settings
  </a>
  <a href="/dashboard/<%= guild.guildId %>/analytics" class="sidebar-link" id="nav-analytics">
    <i class="bi bi-graph-up-arrow"></i> Analytics
  </a>
  <a href="/dashboard/<%= guild.guildId %>/logs" class="sidebar-link" id="nav-logs">
    <i class="bi bi-journal-text"></i> Audit Logs
  </a>

  <hr style="border: 0; border-top: 1px solid var(--border-color); margin: 20px 0;">
  
  <a href="/dashboard" class="sidebar-link">
    <i class="bi bi-arrow-left-short"></i> Back to Servers
  </a>
</aside>
