<%- include('partials/header') %>

<main class="main-wrapper">
  <%- include('partials/sidebar') %>
  
  <section style="display: flex; flex-direction: column; gap: 24px;">
    <div>
      <h2 style="font-size: 28px; margin-bottom: 4px;">Automated Moderation</h2>
      <p>Configure bot AutoMod filters, thresholds, and penalty severities.</p>
    </div>

    <form action="/api/moderation/<%= guild.guildId %>" method="POST">
      <div style="display: flex; flex-direction: column; gap: 20px;">
        
        <!-- Anti-Spam Card -->
        <div class="glass-panel">
          <div class="switch-container">
            <div>
              <h4 style="font-size: 16px; margin-bottom: 4px;">Anti-Spam Filter</h4>
              <p style="font-size: 13px;">Prevents users from sending messages too quickly in a short timeframe.</p>
            </div>
            <label class="switch">
              <input type="checkbox" name="antiSpam_enabled" <%= guild.autoMod?.antiSpam?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Trigger Limit (Messages in 5s)</label>
              <input type="number" name="antiSpam_threshold" value="<%= guild.autoMod?.antiSpam?.threshold || 5 %>" class="form-input" min="2" max="20">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Penalty Action</label>
              <select name="antiSpam_severity" class="form-select">
                <option value="WARN" <%= guild.autoMod?.antiSpam?.severity === 'WARN' ? 'selected' : '' %>>WARN & DELETE</option>
                <option value="TIMEOUT" <%= guild.autoMod?.antiSpam?.severity === 'TIMEOUT' ? 'selected' : '' %>>TIMEOUT (10 mins)</option>
                <option value="MUTE" <%= guild.autoMod?.antiSpam?.severity === 'MUTE' ? 'selected' : '' %>>MUTE ROLE</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Anti-Link Card -->
        <div class="glass-panel">
          <div class="switch-container">
            <div>
              <h4 style="font-size: 16px; margin-bottom: 4px;">Anti-Link Filter</h4>
              <p style="font-size: 13px;">Deletes messages containing external URLs (links).</p>
            </div>
            <label class="switch">
              <input type="checkbox" name="antiLink_enabled" <%= guild.autoMod?.antiLink?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          
          <div style="margin-top: 16px; max-width: 300px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Penalty Action</label>
              <select name="antiLink_severity" class="form-select">
                <option value="WARN" <%= guild.autoMod?.antiLink?.severity === 'WARN' ? 'selected' : '' %>>WARN & DELETE</option>
                <option value="TIMEOUT" <%= guild.autoMod?.antiLink?.severity === 'TIMEOUT' ? 'selected' : '' %>>TIMEOUT</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Anti-Invite Card -->
        <div class="glass-panel">
          <div class="switch-container">
            <div>
              <h4 style="font-size: 16px; margin-bottom: 4px;">Anti-Invite Filter</h4>
              <p style="font-size: 13px;">Deletes messages containing Discord server invite links.</p>
            </div>
            <label class="switch">
              <input type="checkbox" name="antiInvite_enabled" <%= guild.autoMod?.antiInvite?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          
          <div style="margin-top: 16px; max-width: 300px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Penalty Action</label>
              <select name="antiInvite_severity" class="form-select">
                <option value="WARN" <%= guild.autoMod?.antiInvite?.severity === 'WARN' ? 'selected' : '' %>>WARN & DELETE</option>
                <option value="TIMEOUT" <%= guild.autoMod?.antiInvite?.severity === 'TIMEOUT' ? 'selected' : '' %>>TIMEOUT</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Anti-Scam Card -->
        <div class="glass-panel">
          <div class="switch-container">
            <div>
              <h4 style="font-size: 16px; margin-bottom: 4px;">Anti-Scam Filter</h4>
              <p style="font-size: 13px;">Protects members by scanning and removing known phishing, nitro scam links.</p>
            </div>
            <label class="switch">
              <input type="checkbox" name="antiScam_enabled" <%= guild.autoMod?.antiScam?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          
          <div style="margin-top: 16px; max-width: 300px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Penalty Action</label>
              <select name="antiScam_severity" class="form-select">
                <option value="TIMEOUT" <%= guild.autoMod?.antiScam?.severity === 'TIMEOUT' ? 'selected' : '' %>>TIMEOUT (Default)</option>
                <option value="BAN" <%= guild.autoMod?.antiScam?.severity === 'BAN' ? 'selected' : '' %>>BAN MEMBER</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Anti-Mass Mention Card -->
        <div class="glass-panel">
          <div class="switch-container">
            <div>
              <h4 style="font-size: 16px; margin-bottom: 4px;">Anti-Mass Mention Filter</h4>
              <p style="font-size: 13px;">Deletes messages containing more than a set number of user mentions.</p>
            </div>
            <label class="switch">
              <input type="checkbox" name="antiMassMention_enabled" <%= guild.autoMod?.antiMassMention?.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Mention Trigger Limit</label>
              <input type="number" name="antiMassMention_threshold" value="<%= guild.autoMod?.antiMassMention?.threshold || 5 %>" class="form-input" min="3" max="50">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Penalty Action</label>
              <select name="antiMassMention_severity" class="form-select">
                <option value="TIMEOUT" <%= guild.autoMod?.antiMassMention?.severity === 'TIMEOUT' ? 'selected' : '' %>>TIMEOUT (10 mins)</option>
                <option value="WARN" <%= guild.autoMod?.antiMassMention?.severity === 'WARN' ? 'selected' : '' %>>WARN & DELETE</option>
              </select>
            </div>
          </div>
        </div>

      </div>
      
      <button type="submit" class="btn btn-primary" style="margin-top: 24px;"><i class="bi bi-save-fill"></i> Save Rules</button>
    </form>
  </section>
</main>

<script>
  document.getElementById('nav-moderation').classList.add('active');
</script>

<%- include('partials/footer') %>
