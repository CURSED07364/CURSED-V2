<%- include('partials/header') %>

<main class="main-wrapper">
  <%- include('partials/sidebar') %>
  
  <section style="display: flex; flex-direction: column; gap: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <h2 style="font-size: 28px; margin-bottom: 4px;">Server Overview</h2>
        <p>Manage basic guild configurations and see quick stats.</p>
      </div>
      <span class="badge <%= guild.isPremium ? 'badge-premium' : 'badge-free' %>">
        <%= guild.isPremium ? '👑 PREMIUM' : 'FREE tier' %>
      </span>
    </div>

    <!-- Quick Stats Row -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
      <div class="glass-panel" style="padding: 20px; text-align: center;">
        <span style="font-size: 13px; color: var(--text-secondary); display: block; margin-bottom: 8px;">Active Support Tickets</span>
        <strong style="font-size: 28px; color: var(--accent-glow);"><%= ticketsCount %></strong>
      </div>
      <div class="glass-panel" style="padding: 20px; text-align: center;">
        <span style="font-size: 13px; color: var(--text-secondary); display: block; margin-bottom: 8px;">Total Server Warnings</span>
        <strong style="font-size: 28px; color: var(--error-color);"><%= warningsCount %></strong>
      </div>
      <div class="glass-panel" style="padding: 20px; text-align: center;">
        <span style="font-size: 13px; color: var(--text-secondary); display: block; margin-bottom: 8px;">API Connectivity</span>
        <strong style="font-size: 28px; color: var(--success-color);"><%= botPing %> ms</strong>
      </div>
    </div>

    <!-- Main Config Form -->
    <div class="glass-panel">
      <h3 style="font-size: 18px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
        <i class="bi bi-gear-fill" style="color: var(--accent-glow);"></i> Core Settings
      </h3>
      
      <form action="/api/config/<%= guild.guildId %>" method="POST">
        <div class="form-group">
          <label class="form-label">Command Prefix</label>
          <input type="text" name="prefix" value="<%= guild.prefix %>" class="form-input" style="max-width: 150px;" required>
          <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-top: 4px;">Prefix used to execute chat commands.</span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="form-group">
            <label class="form-label">Moderation Log Channel ID</label>
            <input type="text" name="logChannelId" value="<%= guild.logChannelId || '' %>" placeholder="112233445566778899" class="form-input">
            <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-top: 4px;">Channel where moderation alerts are logged.</span>
          </div>

          <div class="form-group">
            <label class="form-label">Welcome Channel ID</label>
            <input type="text" name="welcomeChannelId" value="<%= guild.welcomeChannelId || '' %>" placeholder="112233445566778899" class="form-input">
            <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-top: 4px;">Channel where welcome alerts are sent.</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Welcome Announcement Message</label>
          <textarea name="welcomeMessage" rows="3" class="form-textarea"><%= guild.welcomeMessage %></textarea>
          <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-top: 4px;">Custom message for new users. Use `{user}` tag to mention the member.</span>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill"></i> Save Settings</button>
      </form>
    </div>
  </section>
</main>

<script>
  document.getElementById('nav-overview').classList.add('active');
</script>

<%- include('partials/footer') %>
