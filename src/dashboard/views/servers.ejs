<%- include('partials/header') %>

<main class="main-wrapper" style="grid-template-columns: 1fr;">
  <div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <h2 style="font-size: 28px;">Welcome, <%= user.username %>!</h2>
      <p>Select a Discord server to configure settings, review logs, and manage premium.</p>
    </div>
    
    <div class="glass-panel" style="padding: 12px 24px; display: flex; align-items: center; gap: 16px;">
      <i class="bi bi-star-fill" style="color: gold; font-size: 20px;"></i>
      <div>
        <span style="font-size: 12px; color: var(--text-secondary); display: block;">YOUR PLAN</span>
        <strong style="font-size: 14px;"><%= premium.tier %></strong>
      </div>
    </div>
  </div>

  <!-- Code Redemption -->
  <div class="glass-panel" style="margin-bottom: 32px;">
    <h3 style="margin-bottom: 12px; font-size: 18px;"><i class="bi bi-gift-fill" style="color: var(--accent-glow);"></i> Redeem Premium Code</h3>
    <form action="/api/premium/redeem" method="POST" style="display: flex; gap: 12px; max-width: 500px;">
      <input type="text" name="code" placeholder="CURSED-PREMIUM-XXXXXX" class="form-input" required>
      <button type="submit" class="btn btn-primary" style="white-space: nowrap;">Redeem Code</button>
    </form>
  </div>

  <h3 style="margin-bottom: 16px; font-size: 20px;">Select a Server</h3>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
    <% guilds.forEach(guild => { %>
      <div class="glass-panel" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; padding: 32px 24px;">
        <% if (guild.icon) { %>
          <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="Guild Icon" style="width: 72px; height: 72px; border-radius: 50%; border: 2px solid var(--border-color);">
        <% } else { %>
          <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--border-color); display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; border: 2px solid var(--border-color);">
            <%= guild.name.split(' ').map(w => w[0]).join('').slice(0, 3).toUpperCase() %>
          </div>
        <% } %>
        
        <div>
          <h4 style="font-size: 18px; margin-bottom: 4px;"><%= guild.name %></h4>
          <span style="font-size: 12px; color: var(--text-secondary);"><%= guild.isJoined ? 'Joined' : 'Not Joined' %></span>
        </div>

        <div style="margin-top: auto; width: 100%;">
          <% if (guild.isJoined) { %>
            <a href="/dashboard/<%= guild.id %>" class="btn btn-primary" style="width: 100%; justify-content: center;">Configure Server</a>
          <% } else { %>
            <a href="https://discord.com/api/oauth2/authorize?client_id=<%= config.discord.clientId %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= guild.id %>" class="btn btn-secondary" style="width: 100%; justify-content: center;" target="_blank">Invite Bot</a>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</main>

<%- include('partials/footer') %>
