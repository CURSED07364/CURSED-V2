<%- include('partials/header') %>

<main style="max-width: 900px; margin: 80px auto; padding: 0 24px; text-align: center; flex-grow: 1;">
  <div style="margin-bottom: 48px;">
    <i class="bi bi-skull-fill" style="font-size: 80px; color: var(--accent-glow); text-shadow: 0 0 30px rgba(144, 85, 255, 0.4);"></i>
    <h1 style="font-size: 56px; margin: 24px 0 16px 0; background: linear-gradient(135deg, #fff 40%, var(--accent-glow) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      Rule Your Server with CURSED
    </h1>
    <p style="font-size: 18px; max-width: 600px; margin: 0 auto 32px auto;">
      The ultimate production-ready Discord SaaS bot. Powered by advanced Groq/Gemini AI, automated moderation rules, deep server analytics, image generators, and support ticket systems.
    </p>
    
    <div style="display: flex; gap: 16px; justify-content: center;">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
      <% } else { %>
        <a href="/auth" class="btn btn-primary btn-lg"><i class="bi bi-discord"></i> Login with Discord</a>
      <% } %>
      <a href="https://discord.com/api/oauth2/authorize?client_id=<%= config.discord.clientId %>&permissions=8&scope=bot%20applications.commands" class="btn btn-secondary btn-lg" target="_blank">Invite Bot</a>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin-top: 60px;">
    <div class="glass-panel" style="text-align: left;">
      <i class="bi bi-cpu-fill" style="font-size: 32px; color: var(--accent-glow);"></i>
      <h3 style="margin: 16px 0 8px 0;">Groq & Gemini AI</h3>
      <p style="font-size: 14px;">Intelligent chatting with context memory support, custom personalities, and fallback models.</p>
    </div>
    
    <div class="glass-panel" style="text-align: left;">
      <i class="bi bi-shield-slash-fill" style="font-size: 32px; color: var(--accent-glow);"></i>
      <h3 style="margin: 16px 0 8px 0;">AutoModeration</h3>
      <p style="font-size: 14px;">Instant protection against invites, links, scam links, spamming, and mass mentions.</p>
    </div>

    <div class="glass-panel" style="text-align: left;">
      <i class="bi bi-graph-up-arrow" style="font-size: 32px; color: var(--accent-glow);"></i>
      <h3 style="margin: 16px 0 8px 0;">Detailed Analytics</h3>
      <p style="font-size: 14px;">Monitor member message frequencies, command usage charts, and premium conversion statistics.</p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
